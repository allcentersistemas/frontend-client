# Desarrollo local (copiar a .env.local)

VITE_CLIENT_API_PREFIX=/client-api
VITE_ORDER_API_PREFIX=/order-api

# Monolito module-system
VITE_PROXY_SYSTEM_TARGET=http://localhost:8080

# UI: mostrar ruta /registro (debe coincidir con el backend)
VITE_AUTH_REGISTRATION_ENABLED=true
# Backend module-system: APP_AUTH_REGISTRATION_ENABLED=true (application.properties)
VITE_PREFILL_DEMO_LOGIN=false

# VITE_DEV_PORT=5174
